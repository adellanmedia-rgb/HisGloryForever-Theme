{%- comment -%} One cart line. Params: item, index (1-based line number) {%- endcomment -%}
<li class="cart-item" data-line="{{ index }}" data-key="{{ item.key }}">
  <a href="{{ item.url }}" class="cart-item__media media" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}
      {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.image.alt | default: item.product.title }}
    {%- else -%}
      {{ 'apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </a>
  <div class="cart-item__details">
    <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>
    {%- unless item.product.has_only_default_variant -%}
      <p class="cart-item__options">
        {%- for option in item.options_with_values -%}
          {{ option.name }}: {{ option.value }}{% unless forloop.last %} · {% endunless %}
        {%- endfor -%}
      </p>
    {%- endunless -%}
    {%- for property in item.properties -%}
      {%- assign first_char = property.first | slice: 0 -%}
      {%- if property.last != blank and first_char != '_' -%}
        <p class="cart-item__options">{{ property.first }}: {{ property.last }}</p>
      {%- endif -%}
    {%- endfor -%}
    <div class="cart-item__price">
      {%- if item.original_line_price != item.final_line_price -%}
        <s class="text-muted">{{ item.original_line_price | money }}</s>
      {%- endif -%}
      {{ item.final_line_price | money }}
    </div>
    {%- for discount in item.line_level_discount_allocations -%}
      <p class="cart-item__options">{{ discount.discount_application.title }}</p>
    {%- endfor -%}
    <div class="cart-item__row">
      <div class="quantity">
        <button type="button" class="quantity__button" data-qty-change="-1" aria-label="{{ 'sections.cart.decrease' | t: product: item.product.title }}">
          {% render 'icon', icon: 'minus', class: 'icon--small' %}
        </button>
        <input class="quantity__input" type="number" min="0" value="{{ item.quantity }}" data-qty-input aria-label="{{ 'sections.cart.quantity' | t: product: item.product.title }}">
        <button type="button" class="quantity__button" data-qty-change="1" aria-label="{{ 'sections.cart.increase' | t: product: item.product.title }}">
          {% render 'icon', icon: 'plus', class: 'icon--small' %}
        </button>
      </div>
      <button type="button" class="cart-item__remove" data-remove>{{ 'sections.cart.remove' | t }}</button>
    </div>
    <p class="cart-error" data-line-error hidden></p>
  </div>
</li>
