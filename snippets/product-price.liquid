{%- comment -%} Price for a variant. Params: variant {%- endcomment -%}
{%- if variant.compare_at_price > variant.price -%}
  <s class="product__compare">{{ variant.compare_at_price | money_without_trailing_zeros }}</s>
  <span class="product__price-current product__price-current--sale">{{ variant.price | money_without_trailing_zeros }}</span>
{%- else -%}
  <span class="product__price-current">{{ variant.price | money_without_trailing_zeros }}</span>
{%- endif -%}
