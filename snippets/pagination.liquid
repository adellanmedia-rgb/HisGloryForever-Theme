{%- comment -%} Params: paginate {%- endcomment -%}
<nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
  <ul class="pagination__list" role="list">
    {%- if paginate.previous -%}
      <li>
        <a href="{{ paginate.previous.url }}" class="pagination__item pagination__arrow" data-facet-link aria-label="{{ 'general.pagination.previous' | t }}">
          {% render 'icon', icon: 'arrow-right', class: 'icon--small icon--flip' %}
        </a>
      </li>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      <li>
        {%- if part.is_link -%}
          <a href="{{ part.url }}" class="pagination__item" data-facet-link aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</a>
        {%- elsif part.title == paginate.current_page -%}
          <span class="pagination__item is-current" aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</span>
        {%- else -%}
          <span class="pagination__item">{{ part.title }}</span>
        {%- endif -%}
      </li>
    {%- endfor -%}
    {%- if paginate.next -%}
      <li>
        <a href="{{ paginate.next.url }}" class="pagination__item pagination__arrow" data-facet-link aria-label="{{ 'general.pagination.next' | t }}">
          {% render 'icon', icon: 'arrow-right', class: 'icon--small' %}
        </a>
      </li>
    {%- endif -%}
  </ul>
</nav>
