{%- comment -%}
  HGF colour-name → swatch hex. Printful sends colour names but no swatch data.
  Used when a colour value has no Shopify swatch set. Add a line for each new garment colour.
  Hexes sampled from the garment in HGF product photos.
{%- endcomment -%}
{%- liquid
  assign key = name | handleize
  case key
    when 'bone', 'bone-maroon', 'bone-navy'
      echo '#E3D9CD'
    when 'dusty-rose', 'dusty-rose-maroon'
      echo '#EE9A8D'
    when 'agave', 'agave-kelly-green'
      echo '#BFCCC7'
    when 'sky-blue', 'sky-blue-navy'
      echo '#D7E9F3'
    when 'maroon', 'maroon-old-gold'
      echo '#7A3041'
    when 'team-royal', 'royal', 'team-royal-old-gold'
      echo '#344781'
    when 'purple'
      echo '#603F73'
    when 'carolina-blue'
      echo '#99B6E8'
    when 'lavender'
      echo '#F7D7EC'
    when 'oxford-navy'
      echo '#26303F'
    when 'burgundy'
      echo '#642833'
    when 'light-avio-blue'
      echo '#678FA7'
    when 'cardinal'
      echo '#9A201C'
    when 'forest-green'
      echo '#3A5639'
    when 'carbon-grey'
      echo '#AFACA7'
    when 'light-pink'
      echo '#F6CAC7'
    when 'military-green'
      echo '#5E533A'
    else
      echo key
  endcase
-%}
