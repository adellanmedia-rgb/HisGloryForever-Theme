{%- comment -%}
  Free-shipping progress. Server renders the first state; theme.js keeps it current as the cart changes.
  Params:
    - show_track: true to show the progress line
{%- endcomment -%}
{%- if settings.free_shipping_enabled and settings.free_shipping_threshold > 0 -%}
  {%- liquid
    assign threshold = settings.free_shipping_threshold | times: 100
    assign remaining = threshold | minus: cart.total_price
    assign percent = cart.total_price | times: 100 | divided_by: threshold
    if percent > 100
      assign percent = 100
    endif
    assign threshold_money = threshold | money_without_trailing_zeros
    assign remaining_money = remaining | money
  -%}
  <div class="free-shipping" data-free-shipping>
    <p class="free-shipping__text" data-free-shipping-text>
      {%- if cart.item_count == 0 -%}
        {{ 'general.free_shipping.intro' | t: amount: threshold_money }}
      {%- elsif remaining > 0 -%}
        {{ 'general.free_shipping.away' | t: amount: remaining_money }}
      {%- else -%}
        {{ 'general.free_shipping.unlocked' | t }}
      {%- endif -%}
    </p>
    {%- if show_track -%}
      <div class="free-shipping__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ percent }}" aria-label="{{ 'general.free_shipping.progress_label' | t }}">
        <div class="free-shipping__fill" data-free-shipping-fill style="width: {{ percent }}%;"></div>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
