{%- comment -%} Params: article, show_excerpt {%- endcomment -%}
<article class="article-card">
  <a href="{{ article.url }}" class="article-card__media media" tabindex="-1" aria-hidden="true">
    {%- if article.image -%}
      {{ article.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw', widths: '450, 600, 900, 1200', alt: article.image.alt | default: article.title }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </a>
  <div class="article-card__body">
    <p class="article-card__meta">
      {{ article.published_at | time_tag: format: 'date' }}
      {% if article.tags.size > 0 %} · {{ article.tags.first | escape }}{% endif %}
    </p>
    <h2 class="h3 article-card__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
    {%- if show_excerpt -%}
      <p class="article-card__excerpt text-muted">
        {%- if article.excerpt != blank -%}{{ article.excerpt | strip_html | truncatewords: 26 }}{%- else -%}{{ article.content | strip_html | truncatewords: 26 }}{%- endif -%}
      </p>
    {%- endif -%}
  </div>
</article>
