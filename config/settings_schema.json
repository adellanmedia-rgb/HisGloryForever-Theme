[
  {
    "name": "theme_info",
    "theme_name": "His Glory Forever",
    "theme_version": "1.0.0",
    "theme_author": "Adellan Media",
    "theme_documentation_url": "https://hisgloryforever.com",
    "theme_support_url": "https://hisgloryforever.com"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Crest or logo image",
        "info": "Optional. The HGF crest is built into the theme in brand navy and switches to white on navy sections automatically. Upload a file here only to override it."
      },
      {
        "type": "image_picker",
        "id": "logo_white",
        "label": "Logo for navy backgrounds",
        "info": "Optional white version, used in the footer and on navy sections."
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 32,
        "max": 160,
        "step": 2,
        "unit": "px",
        "label": "Logo width",
        "default": 34
      },
      {
        "type": "checkbox",
        "id": "logo_show_name",
        "label": "Show \"His Glory Forever\" beside the crest",
        "info": "Turn off if your uploaded logo file already includes the name.",
        "default": true
      },
      {
        "type": "text",
        "id": "logo_name",
        "label": "Name text",
        "default": "His Glory Forever"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Square image, at least 64 × 64px."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "paragraph",
        "content": "HGF palette: navy and white. Each section lets you choose White, Light, or Navy."
      },
      {
        "type": "color",
        "id": "color_navy",
        "label": "Navy",
        "default": "#1B3158"
      },
      {
        "type": "color",
        "id": "color_white",
        "label": "White",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_light",
        "label": "Light background",
        "info": "A barely-there cool white for alternating sections.",
        "default": "#F5F6F8"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Secondary text",
        "default": "#5B6577"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Lines and borders",
        "default": "#E2E5EA"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale price",
        "default": "#1B3158"
      }
    ]
  },
  {
    "name": "Seasonal",
    "settings": [
      {
        "type": "checkbox",
        "id": "winter_theme",
        "label": "Winter theme",
        "info": "Navy cardstock texture on navy sections, a winter treeline across the top of the footer, and gentle snowfall on the homepage hero. Turn this off in the second week of January.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "winter_snow",
        "label": "Snowfall on the homepage hero",
        "info": "Only applies while the winter theme is on. Respects visitors who prefer reduced motion.",
        "default": true
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Headings"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Heading font",
        "default": "playfair_display_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Heading size",
        "default": 100
      },
      {
        "type": "header",
        "content": "Body"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "work_sans_n4"
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "label": "Body size",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Page width",
        "default": 1360
      },
      {
        "type": "range",
        "id": "button_min_width",
        "min": 140,
        "max": 280,
        "step": 10,
        "unit": "px",
        "label": "Button width",
        "info": "Buttons share one width so labels never wrap.",
        "default": 200
      },
      {
        "type": "select",
        "id": "button_style",
        "label": "Button corners",
        "options": [
          { "value": "square", "label": "Square" },
          { "value": "soft", "label": "Slightly rounded" }
        ],
        "default": "square"
      }
    ]
  },
  {
    "name": "Cart and shipping",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "When someone adds to cart",
        "options": [
          { "value": "drawer", "label": "Open the slide-out cart" },
          { "value": "page", "label": "Go to the cart page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "free_shipping_enabled",
        "label": "Show free-shipping progress",
        "default": true
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping minimum (in dollars)",
        "info": "Match this to your shipping rates in Settings > Shipping.",
        "default": 100
      },
      {
        "type": "richtext",
        "id": "made_for_you_note",
        "label": "\"Made for you\" note",
        "info": "Shown in the cart and on product pages.",
        "default": "<p>Each piece is made for you after you order.</p>"
      },
      {
        "type": "header",
        "content": "Estimated arrival date"
      },
      {
        "type": "paragraph",
        "content": "Shows \"Order today, arrives …\" under Add to Cart. Dates are counted in business days (Monday to Friday), starting the next business day, and skip the holidays listed below."
      },
      {
        "type": "checkbox",
        "id": "arrival_enabled",
        "label": "Show estimated arrival date",
        "default": true
      },
      {
        "type": "number",
        "id": "arrival_min_days",
        "label": "Earliest arrival (business days)",
        "default": 6
      },
      {
        "type": "number",
        "id": "arrival_max_days",
        "label": "Latest arrival (business days)",
        "default": 11
      },
      {
        "type": "text",
        "id": "arrival_extended_tag",
        "label": "Product tag for a longer window",
        "info": "Products with this tag use the longer window below (for example, items made by a slower supplier).",
        "default": "arrival-extended"
      },
      {
        "type": "number",
        "id": "arrival_extended_min_days",
        "label": "Longer window: earliest (business days)",
        "default": 8
      },
      {
        "type": "number",
        "id": "arrival_extended_max_days",
        "label": "Longer window: latest (business days)",
        "default": 15
      },
      {
        "type": "richtext",
        "id": "made_for_you_note_extended",
        "label": "\"Made for you\" note for tagged products",
        "info": "Shown instead of the regular note on products with the tag above.",
        "default": "<p>Made for you after you order · Ships free</p>"
      },
      {
        "type": "textarea",
        "id": "arrival_holidays",
        "label": "Holidays to skip",
        "info": "One date per line, as YYYY-MM-DD.",
        "default": "2026-11-26\n2026-12-25\n2027-01-01\n2027-05-31\n2027-07-05\n2027-09-06\n2027-11-25\n2027-12-24\n2027-12-31"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "text", "id": "social_instagram_link", "label": "Instagram", "info": "https://instagram.com/HGFOriginal" },
      { "type": "text", "id": "social_facebook_link", "label": "Facebook" },
      { "type": "text", "id": "social_tiktok_link", "label": "TikTok" },
      { "type": "text", "id": "social_youtube_link", "label": "YouTube" },
      { "type": "text", "id": "social_pinterest_link", "label": "Pinterest" }
    ]
  },
  {
    "name": "Share image",
    "settings": [
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Default share image",
        "info": "Shown when your store is shared on social media or in messages. 1200 × 628px recommended."
      }
    ]
  }
]
