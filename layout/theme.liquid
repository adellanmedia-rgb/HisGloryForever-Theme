<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="facebook-domain-verification" content="imtcmkaucrd4mwn7uzfunnrbocqii6" />
    <meta name="theme-color" content="{{ settings.color_navy }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    {%- liquid
      assign hgf_title = page_title
      assign hgf_description = page_description
      if request.page_type == 'index'
        assign hgf_now = 'now' | date: '%s' | plus: 0
        assign hgf_sale_end = 0
        if settings.home_sale_seo_ends_at != blank
          assign hgf_sale_end = settings.home_sale_seo_ends_at | date: '%s' | plus: 0
        endif
        if settings.home_sale_seo_title != blank and hgf_sale_end > hgf_now
          assign hgf_title = settings.home_sale_seo_title
          if settings.home_sale_seo_description != blank
            assign hgf_description = settings.home_sale_seo_description
          endif
        else
          if settings.home_seo_title != blank
            assign hgf_title = settings.home_seo_title
          endif
          if settings.home_seo_description != blank
            assign hgf_description = settings.home_seo_description
          endif
        endif
      endif
    -%}

    <title>
      {{ hgf_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags.first }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless hgf_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if hgf_description %}
      <meta name="description" content="{{ hgf_description | escape }}">
    {% endif %}

    {% render 'meta-tags', title: hgf_title, description: hgf_description %}
    {{ 'cinzel-600.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {% render 'css-variables' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'hgf-refresh.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          search: {{ routes.search_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        freeShippingEnabled: {{ settings.free_shipping_enabled | json }},
        freeShippingThreshold: {{ settings.free_shipping_threshold | times: 100 | json }},
        moneyFormat: {{ shop.money_format | json }},
        strings: {
          freeShippingAway: {{ 'general.free_shipping.away' | t: amount: '[amount]' | replace: '&#39;', "'" | json }},
          freeShippingUnlocked: {{ 'general.free_shipping.unlocked' | t | replace: '&#39;', "'" | json }},
          freeShippingIntro: {{ 'general.free_shipping.intro' | t: amount: '[amount]' | replace: '&#39;', "'" | json }}
        }
      };
    </script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}{% if settings.winter_theme %} theme-winter{% endif %}">
    <a class="skip-link visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}
  </body>
</html>
