{%- assign s = section.settings -%}
<section
  class="recommendations scheme-{{ s.color_scheme }} section-spacing"
  style="--pad-top: {{ s.padding_top }}px; --pad-bottom: {{ s.padding_bottom }}px;"
  data-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ s.limit }}&intent=related"
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <div class="page-width">
      {%- if s.heading != blank -%}
        <div class="section-header-row"><h2 class="h2">{{ s.heading }}</h2></div>
      {%- endif -%}
      <ul class="product-grid product-grid--4 product-grid--scroll-mobile" role="list">
        {%- for rec in recommendations.products -%}
          <li class="product-grid__item">{% render 'product-card', product: rec %}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "You may also like",
  "class": "section-recommendations",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shopify picks related products automatically. You can choose them yourself in the free Search & Discovery app."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "light", "label": "Light" }
      ],
      "default": "white"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the look" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Products to show", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Top spacing", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Bottom spacing", "default": 80 }
  ]
}
{% endschema %}
