{%- assign s = section.settings -%}
<section class="text-columns scheme-{{ s.color_scheme }} section-spacing" style="--pad-top: {{ s.padding_top }}px; --pad-bottom: {{ s.padding_bottom }}px;">
  <div class="page-width">
    {%- if s.heading != blank or s.text != blank -%}
      <div class="text-columns__intro text-center">
        {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="rte text-muted">{{ s.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    <ol class="text-columns__grid text-columns__grid--{{ section.blocks.size }}" role="list">
      {%- for block in section.blocks -%}
        <li class="text-columns__item" {{ block.shopify_attributes }}>
          {%- if s.numbered -%}
            <span class="text-columns__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          {%- elsif block.settings.icon != 'none' -%}
            {% render 'icon', icon: block.settings.icon, class: 'text-columns__icon' %}
          {%- endif -%}
          {%- if block.settings.title != blank -%}<h3 class="h3 text-columns__title">{{ block.settings.title }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<div class="rte text-muted">{{ block.settings.text }}</div>{%- endif -%}
          {%- if block.settings.link_label != blank -%}<a href="{{ block.settings.link }}" class="link-underline">{{ block.settings.link_label }}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Text columns",
  "class": "section-text-columns",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "light", "label": "Light" },
        { "value": "navy", "label": "Navy" }
      ],
      "default": "white"
    },
    { "type": "text", "id": "eyebrow", "label": "Small label above heading" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Intro" },
    { "type": "checkbox", "id": "numbered", "label": "Number the columns (01, 02, 03)", "default": false },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Top spacing", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Bottom spacing", "default": 80 }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "made", "label": "Made for you" },
            { "value": "truck", "label": "Shipping" },
            { "value": "cross", "label": "Cross" },
            { "value": "heart", "label": "Heart" },
            { "value": "gift", "label": "Gift" },
            { "value": "mail", "label": "Mail" },
            { "value": "return", "label": "Returns" },
            { "value": "lock", "label": "Secure" }
          ],
          "default": "none"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Text columns", "blocks": [{ "type": "column" }, { "type": "column" }, { "type": "column" }] }]
}
{% endschema %}
