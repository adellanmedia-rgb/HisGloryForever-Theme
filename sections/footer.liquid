{%- assign scheme = section.settings.color_scheme -%}
<footer class="footer scheme-{{ scheme }}">
  {%- if settings.winter_theme -%}
    <div class="winter__footer" aria-hidden="true">{% render 'winter-scene' %}</div>
  {%- endif -%}
  <div class="page-width footer__top">
    {%- if section.settings.show_signup -%}
      <div class="footer__signup">
        {%- if section.settings.signup_heading != blank -%}
          <h2 class="h2 footer__signup-heading">{{ section.settings.signup_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.signup_text != blank -%}
          <div class="footer__signup-text rte">{{ section.settings.signup_text }}</div>
        {%- endif -%}

        {%- if section.settings.brevo_form != blank -%}
          <div class="brevo-embed brevo-embed--left">{{ section.settings.brevo_form }}</div>
        {%- else -%}
        {%- form 'customer', id: 'FooterSignup', class: 'newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,weekly-verse">
          {%- if section.settings.show_perk and section.settings.perk_text != blank -%}
            <p class="footer__perk">{{ section.settings.perk_text }}</p>
          {%- endif -%}
          <div class="field">
            <label class="visually-hidden" for="FooterSignupEmail">{{ 'sections.footer.email' | t }}</label>
            <input
              id="FooterSignupEmail"
              class="field__input"
              type="email"
              name="contact[email]"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              placeholder="{{ 'sections.footer.email' | t }}"
              required
              {% if form.errors %}aria-invalid="true" aria-describedby="FooterSignupError"{% endif %}
            >
            <button type="submit" class="button">{{ section.settings.signup_button | default: 'Subscribe' }}</button>
          </div>
          {%- if form.errors -%}
            <p class="form-message" id="FooterSignupError" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- elsif form.posted_successfully? -%}
            <p class="form-message" role="status">{{ section.settings.signup_success }}</p>
          {%- endif -%}
          {%- if section.settings.signup_privacy != blank -%}
            <p class="footer__privacy">{{ section.settings.signup_privacy }}</p>
          {%- endif -%}
        {%- endform -%}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="footer__columns">
        {%- for block in section.blocks -%}
          <div class="footer__column" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="footer__heading">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- case block.type -%}
              {%- when 'menu' -%}
                {%- if block.settings.menu.links.size > 0 -%}
                  <ul class="footer__list" role="list">
                    {%- for link in block.settings.menu.links -%}
                      <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              {%- when 'text' -%}
                <div class="footer__text rte">{{ block.settings.text }}</div>
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="page-width"><div class="footer__bottom">
    <div class="footer__brand">
      {%- if section.settings.show_social -%}
        {% render 'social-links' %}
      {%- endif -%}
    </div>
    <p class="footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <ul class="payment-icons" role="list">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div></div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        { "value": "navy", "label": "Navy" },
        { "value": "white", "label": "White" },
        { "value": "light", "label": "Light" }
      ],
      "default": "navy"
    },
    {
      "type": "header",
      "content": "Weekly Verse signup"
    },
    {
      "type": "checkbox",
      "id": "show_signup",
      "label": "Show signup",
      "default": true
    },
    {
      "type": "text",
      "id": "signup_heading",
      "label": "Heading",
      "default": "The Weekly Verse"
    },
    {
      "type": "richtext",
      "id": "signup_text",
      "label": "Text",
      "default": "<p>A scripture in your inbox every week, plus early access to new collections and occasional offers.</p>"
    },
    {
      "type": "html",
      "id": "brevo_form",
      "label": "Brevo form embed code",
      "info": "Optional. Paste a Brevo form's embed code to use it instead of the built-in signup form."
    },
    {
      "type": "text",
      "id": "signup_button",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "signup_success",
      "label": "Success message",
      "default": "Welcome. Your first verse is on its way."
    },
    {
      "type": "text",
      "id": "signup_privacy",
      "label": "Small print",
      "default": "Unsubscribe anytime."
    },
    {
      "type": "checkbox",
      "id": "show_perk",
      "label": "Show a signup perk",
      "info": "Off by default. Turn on if you want to offer something for signing up.",
      "default": false
    },
    {
      "type": "text",
      "id": "perk_text",
      "label": "Perk text",
      "info": "Example: \"Plus 10% off your first order.\" Create the matching discount in Shopify admin."
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social links",
      "info": "Add links in Theme settings > Social media.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Our Why" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>His Glory Forever exists to carry the gospel into everyday life. Every piece points back to Him.</p>"
        }
      ]
    }
  ]
}
{% endschema %}
