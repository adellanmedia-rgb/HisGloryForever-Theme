{%- comment -%}
  Prayer & Praise "coming soon" band.
  Collects early testimonies by email (Shopify contact form), to seed the full community launch in January.
  Deliberately carries no products and does not subscribe anyone to marketing.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="prayer-teaser{% unless s.show_form %} prayer-teaser--compact{% endunless %} scheme-{{ s.color_scheme }} section-spacing" id="prayer-praise" style="--pad-top: {{ s.padding_top }}px; --pad-bottom: {{ s.padding_bottom }}px;">
  <div class="page-width prayer-teaser__inner">
    <div class="prayer-teaser__intro">
      {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="h1">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="rte prayer-teaser__text">{{ s.text }}</div>{%- endif -%}
    </div>

    {%- if s.show_form -%}
    <div class="prayer-teaser__form">
      {%- form 'contact', id: 'TestimonyForm' -%}
        <input type="hidden" name="contact[Type]" value="Testimony">
        {%- if form.posted_successfully? -%}
          <p class="prayer-teaser__success" role="status">{{ s.success_message }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <p class="form-message" role="alert">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <div class="form-grid">
            <div>
              <label class="form-label" for="TestimonyName">{{ 'sections.prayer.name' | t }}</label>
              <input class="field__input" id="TestimonyName" type="text" name="contact[Name]" placeholder="{{ 'sections.prayer.name_placeholder' | t }}" autocomplete="given-name">
            </div>
            <div>
              <label class="form-label" for="TestimonyEmail">{{ 'sections.prayer.email' | t }}</label>
              <input class="field__input" id="TestimonyEmail" type="email" name="contact[email]" required autocomplete="email">
            </div>
            <div class="form-grid__full">
              <label class="form-label" for="TestimonyBody">{{ 'sections.prayer.testimony' | t }}</label>
              <textarea class="field__input" id="TestimonyBody" name="contact[body]" rows="5" required placeholder="{{ 'sections.prayer.testimony_placeholder' | t }}"></textarea>
            </div>
          </div>
          <label class="prayer-teaser__consent" for="TestimonyConsent">
            <input type="checkbox" id="TestimonyConsent" name="contact[Permission to share]" value="Yes" required>
            <span>{{ 'sections.prayer.consent' | t }}</span>
          </label>
          <p class="prayer-teaser__privacy">{{ s.privacy_text }}</p>
          <button type="submit" class="button">{{ s.button_label }}</button>
        {%- endif -%}
      {%- endform -%}
    </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Prayer & Praise teaser",
  "class": "section-prayer-teaser",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        { "value": "navy", "label": "Navy" },
        { "value": "white", "label": "White" },
        { "value": "light", "label": "Light" }
      ],
      "default": "navy"
    },
    { "type": "checkbox", "id": "show_form", "label": "Show testimony form", "info": "Turn off to show only the heading and text (a short teaser).", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Small label above heading", "default": "Prayer & Praise · Coming in January" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What has God done in your life?" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We're building a place for believers to pray for one another and share what God has done. It opens in January. Share your testimony now, and it may be one of the first stories on the wall.</p>"
    },
    {
      "type": "text",
      "id": "privacy_text",
      "label": "Privacy note",
      "default": "Your email stays private and is never shown. Please leave out last names and other people's private details. Nothing is posted until it's reviewed, and your testimony is never used for marketing."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Share my testimony" },
    { "type": "text", "id": "success_message", "label": "Thank-you message", "default": "Thank you for sharing. Praise God." },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Top spacing", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Bottom spacing", "default": 96 }
  ],
  "presets": [{ "name": "Prayer & Praise teaser" }]
}
{% endschema %}
