<div class="page-width account-auth">
  <div class="account-auth__box">
    <h1 class="h1">{{ 'customer.activate.title' | t }}</h1>
    <p class="text-muted">{{ 'customer.activate.text' | t }}</p>
    {%- form 'activate_customer_password' -%}
      {%- if form.errors -%}<p class="form-message" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="account-auth__fields">
        <div>
          <label class="form-label" for="ActivatePassword">{{ 'customer.password' | t }}</label>
          <input class="field__input" id="ActivatePassword" type="password" name="customer[password]" autocomplete="new-password" required>
        </div>
        <div>
          <label class="form-label" for="ActivateConfirm">{{ 'customer.confirm_password' | t }}</label>
          <input class="field__input" id="ActivateConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
        </div>
      </div>
      <button type="submit" class="button button--full">{{ 'customer.activate.submit' | t }}</button>
      <button type="submit" name="decline" class="link-inline account-auth__link">{{ 'customer.activate.decline' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{ "name": "Activate account", "class": "section-main-activate", "settings": [] }
{% endschema %}
