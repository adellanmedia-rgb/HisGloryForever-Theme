{%- assign s = section.settings -%}
<section class="editorial-split editorial-split--image-{{ s.image_side }} scheme-{{ s.color_scheme }}">
  <div class="editorial-split__media media">
    {%- if s.image != blank -%}
      {{ s.image | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 60vw, 100vw', widths: '600, 900, 1200, 1500, 1800', alt: s.image.alt }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="editorial-split__panel">
    <div class="editorial-split__content">
      {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="h1 editorial-split__heading">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="rte editorial-split__text">{{ s.text }}</div>{%- endif -%}
      {%- if s.verse != blank -%}<p class="editorial-split__verse">{{ s.verse }}</p>{%- endif -%}
      {%- if s.button_label != blank -%}
        <div class="button-group">
          <a href="{{ s.button_link }}" class="button{% if s.button_style == 'outline' %} button--secondary{% endif %}">{{ s.button_label }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial split",
  "class": "section-editorial-split",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Text panel colors",
      "options": [
        { "value": "navy", "label": "Navy" },
        { "value": "white", "label": "White" },
        { "value": "light", "label": "Light" }
      ],
      "default": "navy"
    },
    { "type": "text", "id": "eyebrow", "label": "Small label above heading", "default": "Scripture Editorial" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The King is coming. Be ready." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Six designs on the promise of His return. No verse on the front, by design. The reference is stitched on the sleeve, for the conversation it starts.</p>" },
    { "type": "text", "id": "verse", "label": "Verse reference", "info": "Shown in small italic type.", "default": "Matthew 24:42" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "solid"
    }
  ],
  "presets": [{ "name": "Editorial split" }]
}
{% endschema %}
