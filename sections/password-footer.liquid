{%- comment -%}
  Footer for the coming-soon page: social links, a short sign-off and the store-owner login (collapsed).
{%- endcomment -%}
{%- assign s = section.settings -%}
<footer class="password-footer scheme-navy">
  <div class="page-width password-footer__inner">
    <div class="password-footer__crest" aria-hidden="true">{% render 'crest' %}</div>
    {%- if s.heading != blank -%}<p class="password-footer__heading">{{ s.heading }}</p>{%- endif -%}
    {% render 'social-links' %}
    <details class="password__admin">
      <summary>{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password', class: 'password__admin-form' -%}
        {%- if form.errors -%}
          <p class="form-message" role="alert">{{ form.errors | default_errors }}</p>
          <script>document.addEventListener('DOMContentLoaded', () => { document.querySelector('.password__admin').open = true; });</script>
        {%- endif -%}
        <label class="visually-hidden" for="StorePassword">{{ 'password.label' | t }}</label>
        <div class="field">
          <input class="field__input" id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}">
          <button type="submit" class="button">{{ 'password.submit' | t }}</button>
        </div>
      {%- endform -%}
    </details>
    <p class="password-footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ s.brand_name | default: shop.name | escape }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Coming soon footer",
  "class": "section-password-footer",
  "settings": [
    { "type": "text", "id": "heading", "label": "Sign-off line", "default": "Follow along until launch day." },
    { "type": "text", "id": "brand_name", "label": "Name in copyright line", "default": "His Glory Forever" }
  ],
  "presets": [{ "name": "Coming soon footer" }]
}
{% endschema %}
