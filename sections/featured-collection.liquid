{%- liquid
  assign s = section.settings
  assign collection = s.collection
-%}
<section class="featured-collection scheme-{{ s.color_scheme }} section-spacing" style="--pad-top: {{ s.padding_top }}px; --pad-bottom: {{ s.padding_bottom }}px;">
  <div class="page-width">
    <div class="section-header-row">
      <div>
        {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading }}</h2>{%- endif -%}
      </div>
      {%- if s.show_view_all -%}
        <a href="{% if collection != blank %}{{ collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" class="link-underline">{{ 'sections.featured_collection.view_all' | t }}</a>
      {%- endif -%}
    </div>

    <ul class="product-grid product-grid--{{ s.columns }} product-grid--scroll-mobile" role="list">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: s.limit -%}
          <li class="product-grid__item">{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..s.limit) -%}
          {%- assign ph = forloop.index | modulo: 6 | plus: 1 -%}
          <li class="product-grid__item">{% render 'product-card', placeholder_index: ph %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "light", "label": "Light" },
        { "value": "navy", "label": "Navy" }
      ],
      "default": "white"
    },
    { "type": "text", "id": "eyebrow", "label": "Small label above heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 4 },
    {
      "type": "select",
      "id": "columns",
      "label": "Products per row on desktop",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Show \"View all\" link", "default": true },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Top spacing", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Bottom spacing", "default": 80 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
