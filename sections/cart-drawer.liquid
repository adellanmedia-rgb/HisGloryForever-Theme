<div class="overlay" data-cart-overlay></div>

<aside class="cart-drawer scheme-white" id="CartDrawer" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" tabindex="-1" data-cart-drawer>
  <div class="cart-drawer__header">
    <h2 class="cart-drawer__title" id="CartDrawerTitle">
      {{ 'sections.cart.title' | t }}{% if cart.item_count > 0 %} <span class="text-muted">({{ cart.item_count }})</span>{% endif %}
    </h2>
    <button type="button" class="icon-button" data-cart-close>
      {% render 'icon', icon: 'close' %}
      <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
    </button>
  </div>

  {%- if settings.free_shipping_enabled and settings.free_shipping_threshold > 0 -%}
    <div class="cart-drawer__shipping">
      {% render 'free-shipping-bar', show_track: true %}
    </div>
  {%- endif -%}

  <div class="cart-drawer__body">
    {%- if cart.item_count == 0 -%}
      <div class="cart-drawer__empty">
        <p class="h3">{{ 'sections.cart.empty' | t }}</p>
        <a href="{{ section.settings.empty_link | default: routes.all_products_collection_url }}" class="button">{{ 'sections.cart.continue' | t }}</a>
      </div>
    {%- else -%}
      <ul class="cart-items" role="list">
        {%- for item in cart.items -%}
          {% render 'cart-item', item: item, index: forloop.index %}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  {%- if cart.item_count > 0 -%}
    <div class="cart-drawer__footer">
      {%- for discount in cart.cart_level_discount_applications -%}
        <div class="cart-drawer__subtotal text-small">
          <span>{{ discount.title }}</span>
          <span>-{{ discount.total_allocated_amount | money }}</span>
        </div>
      {%- endfor -%}
      <div class="cart-drawer__subtotal">
        <span>{{ 'sections.cart.subtotal' | t }}</span>
        <span>{{ cart.total_price | money_with_currency }}</span>
      </div>
      <p class="cart-drawer__note">{{ 'sections.cart.taxes_shipping' | t }}</p>
      {%- if settings.made_for_you_note != blank -%}
        <div class="made-for-you-note">
          {% render 'icon', icon: 'made' %}
          <div class="rte">{{ settings.made_for_you_note }}</div>
        </div>
      {%- endif -%}
      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="button button--full">{{ 'sections.cart.checkout' | t }}</button>
      </form>
      <a href="{{ routes.cart_url }}" class="link-underline text-center" style="justify-self: center;">{{ 'sections.cart.view_cart' | t }}</a>
    </div>
  {%- endif -%}
</aside>

{% schema %}
{
  "name": "Cart drawer",
  "class": "section-cart-drawer",
  "settings": [
    {
      "type": "url",
      "id": "empty_link",
      "label": "Empty cart button link",
      "info": "Defaults to all products."
    }
  ]
}
{% endschema %}
