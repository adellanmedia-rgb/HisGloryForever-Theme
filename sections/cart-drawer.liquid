<div class="overlay" data-cart-overlay></div>

<aside class="cart-drawer scheme-white" id="CartDrawer" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" tabindex="-1" data-cart-drawer>
  <div class="cart-drawer__header">
    <h2 class="cart-drawer__title" id="CartDrawerTitle">
      {{ 'sections.cart.title' | t }}{% if cart.item_count > 0 %} <span class="text-muted">({{ cart.item_count }})</span>{% endif %}
    </h2>
    <button type="button" class="icon-button" data-cart-close>
      {% render 'icon', icon: 'close' %}
      <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
    </button>
  </div>

  {%- if settings.free_shipping_enabled and settings.free_shipping_threshold > 0 -%}
    <div class="cart-drawer__shipping">
      {% render 'free-shipping-bar', show_track: true %}
    </div>
  {%- endif -%}

  <div class="cart-drawer__body">
    {%- if cart.item_count == 0 -%}
      <div class="cart-drawer__empty">
        <p class="h3">{{ 'sections.cart.empty' | t }}</p>
        <a href="{{ section.settings.empty_link | default: routes.all_products_collection_url }}" class="button">{{ 'sections.cart.continue' | t }}</a>
      </div>
    {%- else -%}
      <ul class="cart-items" role="list">
        {%- for item in cart.items -%}
          <li class="cart-item" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
            <a href="{{ item.url }}" class="cart-item__media media" tabindex="-1" aria-hidden="true">
              {%- if item.image -%}
                {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.image.alt | default: item.product.title }}
              {%- else -%}
                {{ 'apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </a>
            <div class="cart-item__details">
              <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <p class="cart-item__options">
                  {%- for option in item.options_with_values -%}
                    {{ option.name }}: {{ option.value }}{% unless forloop.last %} · {% endunless %}
                  {%- endfor -%}
                </p>
              {%- endunless -%}
              {%- for property in item.properties -%}
                {%- assign first_char = property.first | slice: 0 -%}
                {%- if property.last != blank and first_char != '_' -%}
                  <p class="cart-item__options">{{ property.first }}: {{ property.last }}</p>
                {%- endif -%}
              {%- endfor -%}
              <div class="cart-item__price">
                {%- if item.original_line_price != item.final_line_price -%}
                  <s class="text-muted">{{ item.original_line_price | money }}</s>
                {%- endif -%}
                {{ item.final_line_price | money }}
              </div>
              {%- for discount in item.line_level_discount_allocations -%}
                <p class="cart-item__options">{{ discount.discount_application.title }}</p>
              {%- endfor -%}
              <div class="cart-item__row">
                <div class="quantity">
                  <button type="button" class="quantity__button" data-qty-change="-1" aria-label="{{ 'sections.cart.decrease' | t: product: item.product.title }}">
                    {% render 'icon', icon: 'minus', class: 'icon--small' %}
                  </button>
                  <input class="quantity__input" type="number" min="0" value="{{ item.quantity }}" data-qty-input aria-label="{{ 'sections.cart.quantity' | t: product: item.product.title }}">
                  <button type="button" class="quantity__button" data-qty-change="1" aria-label="{{ 'sections.cart.increase' | t: product: item.product.title }}">
                    {% render 'icon', icon: 'plus', class: 'icon--small' %}
                  </button>
                </div>
                <button type="button" class="cart-item__remove" data-remove>{{ 'sections.cart.remove' | t }}</button>
              </div>
              <p class="cart-error" data-line-error hidden></p>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  {%- if cart.item_count > 0 -%}
    <div class="cart-drawer__footer">
      {%- for discount in cart.cart_level_discount_applications -%}
        <div class="cart-drawer__subtotal text-small">
          <span>{{ discount.title }}</span>
          <span>-{{ discount.total_allocated_amount | money }}</span>
        </div>
      {%- endfor -%}
      <div class="cart-drawer__subtotal">
        <span>{{ 'sections.cart.subtotal' | t }}</span>
        <span>{{ cart.total_price | money_with_currency }}</span>
      </div>
      <p class="cart-drawer__note">{{ 'sections.cart.taxes_shipping' | t }}</p>
      {%- if settings.made_for_you_note != blank -%}
        <div class="made-for-you-note">
          {% render 'icon', icon: 'made' %}
          <div class="rte">{{ settings.made_for_you_note }}</div>
        </div>
      {%- endif -%}
      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="button button--full">{{ 'sections.cart.checkout' | t }}</button>
      </form>
      <a href="{{ routes.cart_url }}" class="link-underline text-center" style="justify-self: center;">{{ 'sections.cart.view_cart' | t }}</a>
    </div>
  {%- endif -%}
</aside>

{% schema %}
{
  "name": "Cart drawer",
  "class": "section-cart-drawer",
  "settings": [
    {
      "type": "url",
      "id": "empty_link",
      "label": "Empty cart button link",
      "info": "Defaults to all products."
    }
  ]
}
{% endschema %}
