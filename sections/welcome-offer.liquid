{%- comment -%}
  Welcome 10% offer. Desktop and phones: a small navy teaser card bottom-left
  ("10% off your first order / Sign up to get your code"). Its x shrinks it to the gold "10% off" pill for the visit.
  The sign-up card opens only when the teaser or pill is tapped (phones: as a bottom panel). Never on cart/checkout,
  never for logged-in customers or visitors arriving from email. Closing only closes the card (the tab stays);
  signed up = never again. Add ?welcome=preview to any URL to open it right away (testing).
  Promo mode: while a promo is scheduled (Promo card settings), the same card advertises the sale instead,
  links to the promo page, and the sign-up offer is hidden. It switches back on its own when the promo ends.
{%- endcomment -%}
{%- liquid
  assign now_ts = 'now' | date: '%s' | plus: 0
  assign promo_start = 0
  assign promo_end = 0
  if section.settings.promo_starts_at != blank
    assign promo_start = section.settings.promo_starts_at | date: '%s' | plus: 0
  endif
  if section.settings.promo_ends_at != blank
    assign promo_end = section.settings.promo_ends_at | date: '%s' | plus: 0
  endif
  assign promo_configured = false
  if section.settings.promo_title != blank and promo_end > 0
    assign promo_configured = true
  endif
  assign promo_live = false
  if promo_configured and promo_start <= now_ts and promo_end > now_ts
    assign promo_live = true
  endif

  assign hide = false
  if customer and promo_live == false
    assign hide = true
  endif
  if template.name == 'cart' or template.name == 'password' or request.design_mode
    assign hide = true
  endif
  assign app_blocks = section.blocks | where: 'type', '@app'
  assign has_form = true
  if app_blocks.size == 0
    assign has_form = false
  endif
-%}
{%- if hide == false and has_form or hide == false and promo_configured -%}
<div class="welcome" id="HgfWelcome" hidden data-delay="{{ section.settings.delay }}" data-scroll="{{ section.settings.scroll }}"
  data-promo-start="{{ promo_start }}" data-promo-end="{{ promo_end }}" data-promo-link="{{ section.settings.promo_link | default: '/collections/all' }}"
  data-has-form="{{ has_form }}" data-customer="{% if customer %}true{% else %}false{% endif %}">
  <div class="welcome__teaser">
    <button type="button" class="welcome__card" aria-controls="HgfWelcomePanel" aria-expanded="false">
      <span class="welcome__card-mark" aria-hidden="true">{% render 'crest', class: 'welcome__card-crest' %}</span>
      <span class="welcome__card-body">
        <span class="welcome__card-title" data-mode="welcome">{%- assign hgf_t = section.settings.teaser_title | split: ' ' -%}{%- if hgf_t.first contains '%' -%}<span class="welcome__num">{{ hgf_t.first }}</span>{{ section.settings.teaser_title | remove_first: hgf_t.first }}{%- else -%}{{ section.settings.teaser_title }}{%- endif -%}</span>
        <span class="welcome__card-text" data-mode="welcome"><span class="welcome__card-link">{{ section.settings.teaser_text }}</span> <span class="welcome__card-arrow" aria-hidden="true">&rarr;</span></span>
        {%- if promo_configured -%}
          <span class="welcome__card-title" data-mode="promo" hidden>{%- assign hgf_pt = section.settings.promo_title | split: ' ' -%}{%- if hgf_pt.first contains '%' -%}<span class="welcome__num">{{ hgf_pt.first }}</span>{{ section.settings.promo_title | remove_first: hgf_pt.first }}{%- else -%}{{ section.settings.promo_title }}{%- endif -%}</span>
          <span class="welcome__card-text" data-mode="promo" hidden><span class="welcome__card-link">{{ section.settings.promo_text }}</span> <span class="welcome__card-arrow" aria-hidden="true">&rarr;</span></span>
        {%- endif -%}
      </span>
    </button>
    <button type="button" class="welcome__card-x" aria-label="Minimise offer">
      <svg viewBox="0 0 16 16" width="10" height="10" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>
    </button>
  </div>
  <button type="button" class="welcome__tab" aria-controls="HgfWelcomePanel" aria-expanded="false"><span data-mode="welcome">{%- assign hgf_p = section.settings.tab_label | split: ' ' -%}{%- if hgf_p.first contains '%' -%}<span class="welcome__num">{{ hgf_p.first }}</span>{{ section.settings.tab_label | remove_first: hgf_p.first }}{%- else -%}{{ section.settings.tab_label }}{%- endif -%}</span>{%- if promo_configured -%}<span data-mode="promo" hidden>{%- assign hgf_pp = section.settings.promo_tab_label | split: ' ' -%}{%- if hgf_pp.first contains '%' -%}<span class="welcome__num">{{ hgf_pp.first }}</span>{{ section.settings.promo_tab_label | remove_first: hgf_pp.first }}{%- else -%}{{ section.settings.promo_tab_label }}{%- endif -%}</span>{%- endif -%}</button>
  <div class="welcome__panel" id="HgfWelcomePanel" role="dialog" aria-modal="false" aria-labelledby="HgfWelcomeTitle">
    <button type="button" class="welcome__close" aria-label="Close">
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/></svg>
    </button>
    <div class="welcome__head">
      {% render 'crest', class: 'welcome__crest' %}
      <p class="welcome__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="welcome__title" id="HgfWelcomeTitle">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}<p class="welcome__text">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="welcome__form">
      {%- for block in app_blocks -%}{% render block %}{%- endfor -%}
    </div>
    <button type="button" class="welcome__nothanks">{{ section.settings.no_thanks }}</button>
  </div>
</div>
<style>
  .welcome { position: fixed; z-index: 60; inset: auto 0 0 0; pointer-events: none; font-size: 1.4rem; }
  .welcome[hidden] { display: none; }
  .welcome [data-mode][hidden] { display: none !important; }
  {%- liquid
    assign hgf_heading_bold = settings.type_heading_font | font_modify: 'weight', 'bold'
    assign hgf_bold_weight = 700
    if hgf_heading_bold
      assign hgf_bold_weight = hgf_heading_bold.weight
    endif
  -%}
  {%- if hgf_heading_bold %}{{ hgf_heading_bold | font_face: font_display: 'swap' }}{% endif %}
  .welcome__panel { pointer-events: auto; background: var(--color-navy, #13233F); color: #fff; box-shadow: 0 1.2rem 4rem rgba(10,20,40,.28); padding: 2.4rem 2.4rem 1.6rem; position: relative; }
  .welcome__close { position: absolute; top: 1.2rem; right: 1.2rem; background: none; border: 0; color: rgba(255,255,255,.7); padding: .6rem; cursor: pointer; line-height: 0; }
  .welcome__close:hover { color: #fff; }
  .welcome__head { text-align: center; }
  .welcome__crest { display: block; margin: 0 auto; width: 2.6rem; height: auto; color: #fff; opacity: .9; }
  .welcome__eyebrow { margin: 1rem 0 .4rem; font-size: 1.1rem; letter-spacing: .18em; text-transform: uppercase; color: rgba(255,255,255,.7); }
  .welcome__title { font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 2.6rem; line-height: 1.15; margin: 0; color: #fff; }
  .welcome__text { margin: .8rem auto 0; max-width: 30rem; font-size: 1.35rem; line-height: 1.5; color: rgba(255,255,255,.78); }
  .welcome__form { margin-top: 1.2rem; }
  .welcome__nothanks { display: block; margin: .2rem auto 0; background: none; border: 0; color: rgba(255,255,255,.6); font-size: 1.2rem; text-decoration: underline; text-underline-offset: .25em; cursor: pointer; padding: .6rem; }
  .welcome__tab { display: block; position: fixed; z-index: 61; pointer-events: none; background: #FBF8F2; color: var(--color-navy, #13233F); font-family: var(--font-heading); font-weight: var(--font-heading-weight); border: 1px solid rgba(201,164,76,.6); border-radius: 10rem; padding: .9rem 1.8rem; font-size: 1.3rem; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; box-shadow: 0 1.2rem 3rem -1rem rgba(10,20,40,.45); opacity: 0; transform: translateY(1rem); transition: opacity .35s ease, transform .35s ease; }
  .welcome.is-tab.is-mini .welcome__tab { opacity: 1; transform: none; pointer-events: auto; }
  .welcome.is-open .welcome__tab { opacity: 0; pointer-events: none; }
  /* teaser card: ivory gift card with crest, serif title, gold hairline */
  .welcome__teaser { position: fixed; z-index: 61; width: 34rem; pointer-events: none; opacity: 0; visibility: hidden; transform: translateY(1.2rem); filter: blur(3px); transition: opacity .35s ease, transform .35s ease, filter .35s ease, visibility 0s .35s; }
  .welcome.is-tab:not(.is-mini):not(.is-open) .welcome__teaser { pointer-events: auto; opacity: 1; visibility: visible; transform: none; filter: none; transition: opacity .8s ease, transform .9s cubic-bezier(.16,1,.3,1), filter .8s ease, visibility 0s; }
  .welcome__card { position: relative; display: flex; align-items: center; gap: 1.4rem; width: 100%; text-align: left; cursor: pointer; background: #FBF8F2; color: var(--color-navy, #13233F); border: 1px solid rgba(201,164,76,.45); border-radius: 1.2rem; padding: 1.5rem 3.8rem 1.5rem 1.5rem; box-shadow: 0 1.8rem 4.5rem -1.2rem rgba(10,20,40,.45), 0 .2rem .6rem rgba(10,20,40,.12); font: inherit; overflow: hidden; transition: box-shadow .4s ease, transform .4s ease; }
  .welcome__card::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 2px; background: linear-gradient(90deg, transparent, #C9A44C 20%, #E6CF8E 50%, #C9A44C 80%, transparent); transform: scaleX(0); transform-origin: left; }
  .welcome.is-tab:not(.is-mini):not(.is-open) .welcome__card::before { animation: hgfLine 1.1s cubic-bezier(.65,0,.35,1) .45s forwards; }
  .welcome__card:hover { transform: translateY(-2px); box-shadow: 0 2.4rem 5rem -1.2rem rgba(10,20,40,.5), 0 .2rem .6rem rgba(10,20,40,.12); }
  .welcome__card-mark { flex: 0 0 auto; display: grid; place-items: center; width: 4.6rem; height: 4.6rem; border-radius: 50%; background: var(--color-navy, #13233F); box-shadow: inset 0 0 0 1px rgba(201,164,76,.6); }
  .welcome__card-crest { display: block; width: 2.4rem; height: auto; color: #C9A44C; }
  .welcome__card-body { display: block; min-width: 0; }
  .welcome__card-title { display: block; font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 1.5rem; letter-spacing: .1em; text-transform: uppercase; line-height: 1.25; color: var(--color-navy, #13233F); white-space: nowrap; }
  .welcome__card-text { display: block; margin-top: .5rem; font-size: 1.3rem; line-height: 1.3; color: #3E4759; }
  .welcome__card-link { background: linear-gradient(#C9A44C, #C9A44C) 0 100% / 0 1px no-repeat; transition: background-size .35s ease, color .35s ease; }
  .welcome__card:hover .welcome__card-link { background-size: 100% 1px; color: var(--color-navy, #13233F); }
  .welcome__card-arrow { display: inline-block; color: #B08D3C; animation: hgfNudge 4s ease-in-out 2s infinite; }
  .welcome__card-x { position: absolute; top: .5rem; right: .5rem; background: none; border: 0; color: rgba(19,35,63,.45); padding: .8rem; line-height: 0; cursor: pointer; transition: color .2s ease; }
  .welcome__card-x:hover { color: var(--color-navy, #13233F); }
  .welcome__num { font-size: 1.28em; line-height: 0; letter-spacing: .04em; }
  /* first line of the card and the minimised pill: true bold cut of the heading font */
  .welcome__card-title, .welcome__tab { font-weight: {{ hgf_bold_weight }}; }
  @keyframes hgfLine { to { transform: scaleX(1); } }
  @keyframes hgfNudge { 0%, 80%, 100% { transform: translateX(0); } 88% { transform: translateX(.5rem); } 94% { transform: translateX(0); } }
  /* desktop: corner card above the chat bubble */
  @media (min-width: 750px) {
    .welcome { inset: auto 2.4rem 10rem auto; width: 36rem; }
    .welcome__tab, .welcome__teaser { left: 2.4rem; bottom: 2.4rem; }
    .welcome:not(.is-open) .welcome__panel { visibility: hidden; transition: transform .45s ease, opacity .45s ease, visibility 0s .45s; }
    .welcome__panel { border-radius: .4rem; transform: translateY(2rem); opacity: 0; transition: transform .45s ease, opacity .45s ease; }
    .welcome.is-open .welcome__panel { transform: none; opacity: 1; }
  }
  /* phones: tab bottom-left, panel slides up from the bottom */
  @media (max-width: 749px) {
    .welcome__tab, .welcome__teaser { left: 1.2rem; bottom: 1.6rem; }
    .welcome__teaser { width: calc(100vw - 2.4rem); max-width: 32rem; }
    .welcome__card { gap: 1.2rem; padding: 1.2rem 3.4rem 1.2rem 1.2rem; }
    .welcome__card-mark { width: 4rem; height: 4rem; }
    .welcome__card-crest { width: 2.1rem; }
    .welcome__card-title { font-size: 1.3rem; letter-spacing: .08em; }
    .welcome__card-text { font-size: 1.25rem; }
    .welcome__panel { position: fixed; left: 0; right: 0; bottom: 0; max-height: 88vh; overflow-y: auto; border-radius: 1.2rem 1.2rem 0 0; transform: translateY(105%); transition: transform .4s ease; }
    .welcome:not(.is-open) .welcome__panel { visibility: hidden; transition: transform .4s ease, visibility 0s .4s; }
    .welcome.is-open .welcome__panel { transform: none; }
  }
  @media (prefers-reduced-motion: reduce) { .welcome__panel, .welcome__tab, .welcome__teaser { transition: none !important; } .welcome__card::before { animation: none !important; transform: scaleX(1) !important; } .welcome__card-arrow { animation: none !important; } .welcome__teaser { filter: none !important; } }
</style>
<script>
  (function () {
    var root = document.getElementById('HgfWelcome');
    if (!root) return;
    var KEY_DONE = 'hgf-welcome-done', KEY_SHUT = 'hgf-welcome-closed-visit', KEY_MINI = 'hgf-welcome-mini';
    var nowS = Math.floor(Date.now() / 1000);
    var pStart = Number(root.dataset.promoStart || 0), pEnd = Number(root.dataset.promoEnd || 0);
    var promo = pEnd > 0 && pStart <= nowS && nowS < pEnd;
    if (!promo && (root.dataset.hasForm !== 'true' || root.dataset.customer === 'true')) { root.remove(); return; }
    if (promo) KEY_MINI = 'hgf-promo-mini-' + pEnd;
    root.querySelectorAll('[data-mode]').forEach(function (el) { el.hidden = el.getAttribute('data-mode') !== (promo ? 'promo' : 'welcome'); });
    try { localStorage.removeItem('hgf-welcome-closed'); } catch (e) {}
    var visit = { get: function (k) { try { return sessionStorage.getItem(k); } catch (e) { return null; } }, set: function (k, v) { try { sessionStorage.setItem(k, v); } catch (e) {} } };
    var params = new URLSearchParams(location.search);
    var preview = params.get('welcome') === 'preview' || params.get('welcome') === 'tab';
    var tabOnly = params.get('welcome') === 'tab';
    var store = { get: function (k) { try { return localStorage.getItem(k); } catch (e) { return null; } }, set: function (k, v) { try { localStorage.setItem(k, v); } catch (e) {} } };
    if (!preview) {
      if (store.get(KEY_DONE) && !promo) return;
      var src = ((params.get('utm_medium') || '') + ' ' + (params.get('utm_source') || '')).toLowerCase();
      if (/email|sms|brevo|klaviyo|newsletter/.test(src)) return;
      if (/^\/(cart|checkouts?|account)/.test(location.pathname)) return;
    }
    var mobile = window.matchMedia('(max-width: 749px)').matches;
    var tab = root.querySelector('.welcome__tab');
    var card = root.querySelector('.welcome__card');
    var shown = false, done = false;
    root.hidden = false;
    if (visit.get(KEY_MINI)) root.classList.add('is-mini');
    function open() { root.classList.add('is-open'); tab.setAttribute('aria-expanded', 'true'); card.setAttribute('aria-expanded', 'true'); }
    function close(remember) {
      root.classList.remove('is-open'); tab.setAttribute('aria-expanded', 'false'); card.setAttribute('aria-expanded', 'false');
      if (done) { setTimeout(function () { root.hidden = true; }, 450); } else if (remember) { (root.classList.contains('is-mini') ? tab : card).focus(); }
    }
    function minimise() { root.classList.add('is-mini'); visit.set(KEY_MINI, '1'); tab.focus(); }
    function reveal() {
      if (shown) return; shown = true;
      tabWatch();
    }
    function tabWatch() {
      function upd() { root.classList.add('is-tab'); }
      upd();
    }
    if (promo) {
      var go = function () { location.href = root.dataset.promoLink; };
      tab.addEventListener('click', go);
      card.addEventListener('click', go);
      tab.removeAttribute('aria-controls'); card.removeAttribute('aria-controls');
      tab.removeAttribute('aria-expanded'); card.removeAttribute('aria-expanded');
    } else {
      tab.addEventListener('click', open);
      card.addEventListener('click', open);
    }
    root.querySelector('.welcome__card-x').addEventListener('click', minimise);
    root.querySelector('.welcome__close').addEventListener('click', function () { close(true); });
    root.querySelector('.welcome__nothanks').addEventListener('click', function () { close(true); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && root.classList.contains('is-open')) close(true); });
    if (preview) { reveal(); if (mobile && !tabOnly && !promo) open(); }
    else {
      setTimeout(reveal, (parseInt(root.dataset.delay, 10) || 10) * 1000);
      window.addEventListener('scroll', function onScroll() {
        var h = document.documentElement.scrollHeight - innerHeight;
        if (h > 0 && scrollY / h >= (parseInt(root.dataset.scroll, 10) || 40) / 100) { reveal(); removeEventListener('scroll', onScroll); }
      }, { passive: true });
    }
    // style the Shopify Forms embed (shadow DOM) and detect a successful signup
    var css = '[class*=formSubmitButton],[class*=formSubmitButton] *{text-transform:uppercase!important;letter-spacing:.14em!important;font-size:13px!important;font-weight:500!important}[class*=checkboxField] [class*=textBody]{font-size:12px!important;line-height:1.45!important;color:rgba(255,255,255,.72)!important}';
    var tries = 0;
    (function watch() {
      var host = root.querySelector('shopify-forms-embed');
      var sr = host && host.shadowRoot;
      if (sr && !sr.querySelector('style[data-hgf]')) { var el = document.createElement('style'); el.setAttribute('data-hgf', ''); el.textContent = css; sr.appendChild(el); }
      if (sr && /WELCOME10/.test(sr.textContent || '')) { store.set(KEY_DONE, '1'); done = true; return; }
      if (tries++ < 2400) setTimeout(watch, 500);
    })();
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Welcome offer",
  "class": "section-welcome-offer",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Welcome to His Glory Forever" },
    { "type": "text", "id": "title", "label": "Heading", "default": "10% off your first order" },
    { "type": "text", "id": "text", "label": "Text", "default": "Join for the Weekly Verse, new releases and offers." },
    { "type": "text", "id": "teaser_title", "label": "Teaser card heading", "default": "10% off your first order" },
    { "type": "text", "id": "teaser_text", "label": "Teaser card text", "default": "Sign up to get your code" },
    { "type": "text", "id": "tab_label", "label": "Minimised pill label", "default": "10% off" },
    { "type": "text", "id": "no_thanks", "label": "No thanks label", "default": "No thanks" },
    { "type": "range", "id": "delay", "label": "Show after (seconds)", "min": 3, "max": 30, "step": 1, "default": 10 },
    { "type": "range", "id": "scroll", "label": "Or after scrolling (%)", "min": 10, "max": 90, "step": 5, "default": 40 },
    { "type": "header", "content": "Promo card", "info": "While a promo is running, the card advertises it instead of the sign-up offer, then switches back on its own." },
    { "type": "text", "id": "promo_title", "label": "Promo card heading" },
    { "type": "text", "id": "promo_text", "label": "Promo card text" },
    { "type": "text", "id": "promo_tab_label", "label": "Promo minimised pill label" },
    { "type": "url", "id": "promo_link", "label": "Promo card link" },
    { "type": "text", "id": "promo_starts_at", "label": "Promo starts", "info": "Optional. Format: 2026-11-24 00:00:00 -0500 (-0500 = Eastern Time)." },
    { "type": "text", "id": "promo_ends_at", "label": "Promo ends", "info": "Format: 2026-11-30 23:59:59 -0500 (-0500 = Eastern Time)." }
  ],
  "blocks": [{ "type": "@app" }]
}
{% endschema %}
