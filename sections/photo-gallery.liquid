{%- assign s = section.settings -%}
<section class="gallery scheme-{{ s.color_scheme }} section-spacing" style="--pad-top: {{ s.padding_top }}px; --pad-bottom: {{ s.padding_bottom }}px;">
  <div class="page-width">
    {%- if s.heading != blank or s.link_label != blank -%}
      <div class="section-header-row">
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.link_label != blank -%}<a href="{{ s.link }}" class="link-underline" target="_blank" rel="noopener">{{ s.link_label }}</a>{%- endif -%}
      </div>
    {%- endif -%}
    <ul class="gallery__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="gallery__item" {{ block.shopify_attributes }}>
          {%- capture gallery_image -%}
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 17vw, 33vw', widths: '300, 450, 600', alt: block.settings.image.alt }}
            {%- else -%}
              {%- assign ph = forloop.index | modulo: 2 | plus: 1 -%}
              {{ 'lifestyle-' | append: ph | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          {%- endcapture -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="media gallery__media">{{ gallery_image }}</a>
          {%- else -%}
            <div class="media gallery__media">{{ gallery_image }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Photo gallery",
  "class": "section-gallery",
  "max_blocks": 12,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "light", "label": "Light" },
        { "value": "navy", "label": "Navy" }
      ],
      "default": "white"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Worn in faith" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Follow @HGFOriginal" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Top spacing", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Bottom spacing", "default": 80 }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link", "info": "A product, or the Instagram post." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Photo gallery",
      "blocks": [
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" },
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
