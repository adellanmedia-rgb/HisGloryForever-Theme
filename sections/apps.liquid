<div class="apps-section scheme-{{ section.settings.color_scheme }} section-spacing" style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="apps-section__inner" style="max-width: {{ section.settings.max_width }}rem; margin: 0 auto;">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow" style="display:block; text-align:center;">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {% render block %}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Apps",
  "tag": "section",
  "class": "section-apps",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)" },
    {
      "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "light",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "navy", "label": "Navy" }
      ]
    },
    { "type": "range", "id": "max_width", "label": "Max width (rem)", "min": 30, "max": 120, "step": 2, "default": 56 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "default": 64, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "default": 64, "unit": "px" }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Apps" }]
}
{% endschema %}
