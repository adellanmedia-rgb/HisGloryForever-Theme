{%- assign s = section.settings -%}
<section class="faq scheme-{{ s.color_scheme }} section-spacing" style="--pad-top: {{ s.padding_top }}px; --pad-bottom: {{ s.padding_bottom }}px;">
  <div class="page-width">
    <div class="faq__inner">
      {%- if s.heading != blank -%}<h2 class="h1 faq__heading">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="rte text-muted faq__intro">{{ s.text }}</div>{%- endif -%}
      <div class="accordion faq__list">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'group' -%}
              <h3 class="faq__group" {{ block.shopify_attributes }}>{{ block.settings.title }}</h3>
            {%- when 'question' -%}
              <details class="accordion__item" {{ block.shopify_attributes }}>
                <summary>{{ block.settings.question }} {% render 'icon', icon: 'plus', class: 'icon--small icon-plus' %}</summary>
                <div class="accordion__content rte">{{ block.settings.answer }}</div>
              </details>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{%- comment -%} FAQ structured data so answers can appear in search results {%- endcomment -%}
{%- assign question_blocks = section.blocks | where: 'type', 'question' -%}
{%- if question_blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in question_blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "class": "section-faq",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "light", "label": "Light" }
      ],
      "default": "white"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "richtext", "id": "text", "label": "Intro" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Top spacing", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Bottom spacing", "default": 96 }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Group heading",
      "settings": [{ "type": "text", "id": "title", "label": "Title", "default": "Orders" }]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ", "blocks": [{ "type": "question" }, { "type": "question" }] }]
}
{% endschema %}
