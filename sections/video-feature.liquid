{%- assign s = section.settings -%}
<section class="video-feature scheme-{{ s.color_scheme }}" style="--pad-top: {{ s.padding_top }}px; --pad-bottom: {{ s.padding_bottom }}px;">
  <div class="page-width video-feature__grid">
    <div class="video-feature__media">
      {%- if s.video != blank -%}
        <div class="video-feature__frame">
          {{ s.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '900x', class: 'video-feature__video', aria-label: s.video_label }}
          <button type="button" class="video-feature__sound" data-video-sound aria-pressed="false" aria-label="Turn sound on">
            <span class="video-feature__sound-on" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H3v6h3l5 4V5z"/><path d="M23 9l-6 6"/><path d="M17 9l6 6"/></svg>
            </span>
            <span class="video-feature__sound-off" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H3v6h3l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M18.5 5.5a9 9 0 0 1 0 13"/></svg>
            </span>
            <span class="video-feature__sound-label">Sound</span>
          </button>
        </div>
        {%- if s.video_label != blank -%}<p class="video-feature__caption">{{ s.video_label }}</p>{%- endif -%}
      {%- endif -%}
    </div>
    <div class="video-feature__content">
      {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="h1 video-feature__heading">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="rte video-feature__text">{{ s.text }}</div>{%- endif -%}
      {%- if s.verse != blank -%}<p class="video-feature__verse">{{ s.verse }}</p>{%- endif -%}
      {%- if s.button_label != blank -%}
        <div class="button-group">
          <a href="{{ s.button_link }}" class="button">{{ s.button_label }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    if (!root) return;
    var video = root.querySelector('video');
    var btn = root.querySelector('[data-video-sound]');
    if (!video || !btn) return;
    video.muted = true;
    var p = video.play && video.play();
    if (p && p.catch) p.catch(function () {});
    btn.addEventListener('click', function () {
      video.muted = !video.muted;
      if (!video.muted) { video.currentTime = video.currentTime; var q = video.play(); if (q && q.catch) q.catch(function () {}); }
      btn.setAttribute('aria-pressed', String(!video.muted));
      btn.setAttribute('aria-label', video.muted ? 'Turn sound on' : 'Turn sound off');
      btn.classList.toggle('is-on', !video.muted);
    });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { var r = video.play(); if (r && r.catch) r.catch(function () {}); }
          else { video.pause(); }
        });
      }, { threshold: 0.25 }).observe(video);
    }
  })();
</script>

{% schema %}
{
  "name": "Video feature",
  "class": "section-video-feature",
  "settings": [
    { "type": "video", "id": "video", "label": "Video", "info": "Vertical (9:16) or 4:5 video. Plays muted on a loop; shoppers can tap for sound." },
    { "type": "text", "id": "video_label", "label": "Video caption", "default": "The Meaning Series · EP.01" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        { "value": "navy", "label": "Navy" },
        { "value": "white", "label": "White" },
        { "value": "light", "label": "Light" }
      ],
      "default": "navy"
    },
    { "type": "text", "id": "eyebrow", "label": "Small label above heading", "default": "The King Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The King is coming. Be ready." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "verse", "label": "Verse reference" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the King Collection" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Top padding", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Bottom padding", "default": 96 }
  ],
  "presets": [{ "name": "Video feature" }]
}
{% endschema %}
