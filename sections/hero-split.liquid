{%- liquid
  assign s = section.settings
  assign loading = 'eager'
  unless section.index0 == 0
    assign loading = 'lazy'
  endunless
-%}
<section class="hero hero--{{ s.height }} hero--text-{{ s.text_position }}" style="--hero-overlay: {{ s.overlay | divided_by: 100.0 }};">
  <div class="hero__media">
    <div class="hero__image media">
      {%- if s.image_1 != blank -%}
        {{ s.image_1 | image_url: width: 1600 | image_tag: loading: loading, fetchpriority: 'high', sizes: '(min-width: 750px) 50vw, 100vw', widths: '600, 900, 1200, 1600', alt: s.image_1.alt }}
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="hero__image hero__image--second media">
      {%- if s.image_2 != blank -%}
        {{ s.image_2 | image_url: width: 1600 | image_tag: loading: loading, sizes: '50vw', widths: '600, 900, 1200, 1600', alt: s.image_2.alt }}
      {%- else -%}
        {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>

  <div class="hero__content">
    <div class="hero__box">
      {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="hero__heading h0">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<p class="hero__text">{{ s.text }}</p>{%- endif -%}
      {%- if s.button_1_label != blank or s.button_2_label != blank -%}
        <div class="button-group button-group--center">
          {%- if s.button_1_label != blank -%}
            <a href="{{ s.button_1_link }}" class="button button--light">{{ s.button_1_label }}</a>
          {%- endif -%}
          {%- if s.button_2_label != blank -%}
            <a href="{{ s.button_2_link }}" class="button button--light">{{ s.button_2_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Split hero",
  "class": "section-hero",
  "settings": [
    { "type": "image_picker", "id": "image_1", "label": "Left image" },
    { "type": "image_picker", "id": "image_2", "label": "Right image", "info": "Hidden on phones, where the left image fills the screen." },
    { "type": "text", "id": "eyebrow", "label": "Small label above heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not for us. For His glory." },
    { "type": "text", "id": "text", "label": "Text", "default": "Clothing made to carry the Word into everyday life." },
    { "type": "text", "id": "button_1_label", "label": "First button label", "default": "Shop Men" },
    { "type": "url", "id": "button_1_link", "label": "First button link" },
    { "type": "text", "id": "button_2_label", "label": "Second button label", "default": "Shop Women" },
    { "type": "url", "id": "button_2_link", "label": "Second button link" },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "overlay",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Image shading",
      "info": "Darkens the photos so white text stays readable.",
      "default": 25
    }
  ],
  "presets": [{ "name": "Split hero" }]
}
{% endschema %}
