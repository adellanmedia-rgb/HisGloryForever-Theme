{%- liquid
  assign s = section.settings
  assign sizes = s.sizes | split: ','
-%}
<section class="size-table section-spacing" style="--pad-top: {{ s.padding_top }}px; --pad-bottom: {{ s.padding_bottom }}px;">
  <div class="page-width">
    <div class="size-table__inner">
      {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="rte text-muted size-table__text">{{ s.text }}</div>{%- endif -%}
      <div class="size-table__scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">{{ s.first_column }}</th>
              {%- for size in sizes -%}<th scope="col">{{ size | strip }}</th>{%- endfor -%}
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              {%- assign values = block.settings.values | split: ',' -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ block.settings.label }}</th>
                {%- for size in sizes -%}
                  <td>{{ values[forloop.index0] | strip | default: '—' }}</td>
                {%- endfor -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      {%- if s.footnote != blank -%}<p class="size-table__note text-muted">{{ s.footnote }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Size chart",
  "class": "section-size-table",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Classic Tee" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Relaxed, classic fit. Measured flat across the garment.</p>" },
    { "type": "text", "id": "first_column", "label": "First column heading", "default": "Measurement" },
    { "type": "text", "id": "sizes", "label": "Sizes", "info": "Separate with commas.", "default": "S, M, L, XL, 2XL" },
    { "type": "text", "id": "footnote", "label": "Note under the table", "default": "Measurements in inches. Between sizes? Size up for a roomier fit." },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Top spacing", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Bottom spacing", "default": 48 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "label", "label": "Measurement", "default": "Body width" },
        { "type": "text", "id": "values", "label": "Values", "info": "One per size, in the same order, separated by commas." }
      ]
    }
  ],
  "presets": [{ "name": "Size chart", "blocks": [{ "type": "row", "settings": { "label": "Body width" } }, { "type": "row", "settings": { "label": "Body length" } }] }]
}
{% endschema %}
