<div class="page-width not-found">
  <span class="eyebrow">404</span>
  <h1 class="h1">{{ section.settings.heading }}</h1>
  <p class="text-muted">{{ section.settings.text }}</p>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
    <label class="visually-hidden" for="NotFoundSearch">{{ 'sections.header.search' | t }}</label>
    <div class="field"><input class="field__input" id="NotFoundSearch" type="search" name="q" placeholder="{{ 'sections.header.search_placeholder' | t }}"></div>
    <button type="submit" class="button">{{ 'sections.header.search' | t }}</button>
  </form>
  <a href="{{ routes.all_products_collection_url }}" class="link-underline">{{ 'sections.cart.continue' | t }}</a>
</div>

{% schema %}
{
  "name": "Page not found",
  "class": "section-404",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page can't be found." },
    { "type": "text", "id": "text", "label": "Text", "default": "\"Seek, and ye shall find.\" Try a search, or head back to the shop." }
  ]
}
{% endschema %}
