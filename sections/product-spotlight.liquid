{%- assign s = section.settings -%}
<section class="spotlight scheme-{{ s.color_scheme }} section-spacing" style="--pad-top: {{ s.padding_top }}px; --pad-bottom: {{ s.padding_bottom }}px;">
  <div class="page-width">
    {%- if s.heading != blank -%}
      <div class="section-header-row"><h2 class="h2">{{ s.heading }}</h2></div>
    {%- endif -%}
    <div class="spotlight__grid">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        <article class="spotlight__card" {{ block.shopify_attributes }}>
          <a href="{% if product != blank %}{{ product.url }}{% else %}#{% endif %}" class="spotlight__media media" tabindex="-1" aria-hidden="true">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '450, 600, 900, 1200', alt: '' }}
            {%- elsif product.featured_media -%}
              {{ product.featured_media | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '450, 600, 900, 1200', alt: '' }}
            {%- else -%}
              {%- assign ph = forloop.index | plus: 2 -%}
              {{ 'product-' | append: ph | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </a>
          <div class="spotlight__body">
            <h3 class="h3 spotlight__title">
              {%- if product != blank -%}<a href="{{ product.url }}">{{ product.title | escape }}</a>{%- else -%}{{ 'products.placeholder_title' | t }}{%- endif -%}
            </h3>
            {%- if block.settings.story != blank -%}<p class="spotlight__story text-muted">{{ block.settings.story }}</p>{%- endif -%}
            <div class="spotlight__footer">
              {%- if product != blank -%}<span class="card__price">{{ product.price | money_without_trailing_zeros }}</span>{%- endif -%}
              <a href="{% if product != blank %}{{ product.url }}{% else %}#{% endif %}" class="link-underline">{{ block.settings.link_label }}</a>
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product spotlight",
  "class": "section-spotlight",
  "max_blocks": 3,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "light", "label": "Light" },
        { "value": "navy", "label": "Navy" }
      ],
      "default": "light"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The story behind the design" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Top spacing", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Bottom spacing", "default": 80 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Uses the product photo if empty." },
        { "type": "text", "id": "story", "label": "One-line story", "default": "Chosen, not chance. A reminder that you were known before you were born." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop now" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product spotlight",
      "blocks": [
        { "type": "product", "settings": { "story": "Chosen, not chance. A reminder that you were known before you were born." } },
        { "type": "product", "settings": { "story": "Redeemed, written like an element. What you are made of, by grace." } }
      ]
    }
  ]
}
{% endschema %}
