{%- assign s = section.settings -%}
<section class="editorial-duo scheme-{{ s.color_scheme }} section-spacing" style="--pad-top: {{ s.padding_top }}px; --pad-bottom: {{ s.padding_bottom }}px;">
  <div class="page-width">
    {%- if s.heading != blank or s.text != blank -%}
      <div class="editorial-duo__intro text-center">
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="rte text-muted">{{ s.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="editorial-duo__grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" class="editorial-duo__item" {{ block.shopify_attributes }}>
          <div class="editorial-duo__media media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '450, 600, 900, 1200', alt: block.settings.image.alt | default: block.settings.title }}
            {%- else -%}
              {%- assign ph = forloop.index | modulo: 2 | plus: 1 -%}
              {{ 'lifestyle-' | append: ph | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="editorial-duo__caption">
            <h3 class="h3">{{ block.settings.title }}</h3>
            {%- if block.settings.button_label != blank -%}
              <span class="link-underline">{{ block.settings.button_label }}</span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial pair",
  "class": "section-editorial-duo",
  "max_blocks": 2,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "light", "label": "Light" },
        { "value": "navy", "label": "Navy" }
      ],
      "default": "white"
    },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Top spacing", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Bottom spacing", "default": 80 }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Made for her walk" },
        { "type": "text", "id": "button_label", "label": "Link label", "default": "Shop women" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial pair",
      "blocks": [
        { "type": "image", "settings": { "title": "Made for her walk", "button_label": "Shop women" } },
        { "type": "image", "settings": { "title": "Made for his walk", "button_label": "Shop men" } }
      ]
    }
  ]
}
{% endschema %}
