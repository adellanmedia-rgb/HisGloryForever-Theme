{%- assign s = section.settings -%}
<section class="meanings scheme-{{ s.color_scheme }} section-spacing" style="--pad-top: {{ s.padding_top }}px; --pad-bottom: {{ s.padding_bottom }}px;">
  <div class="page-width">
    {%- if s.heading != blank or s.text != blank -%}
      <div class="text-columns__intro text-center">
        {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h1">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="rte text-muted">{{ s.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="meanings__list">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        <article class="meaning" {{ block.shopify_attributes }}>
          <div class="meaning__media media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 40vw, 100vw', widths: '450, 600, 900', alt: block.settings.title }}
            {%- elsif product.featured_media -%}
              {{ product.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 40vw, 100vw', widths: '450, 600, 900', alt: block.settings.title }}
            {%- else -%}
              {%- assign ph = forloop.index | modulo: 6 | plus: 1 -%}
              {{ 'product-' | append: ph | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="meaning__body">
            {%- if block.settings.title != blank -%}<h3 class="h2 meaning__title">{{ block.settings.title }}</h3>{%- endif -%}
            {%- if block.settings.verse != blank -%}<p class="product__verse">{{ block.settings.verse }}</p>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="rte text-muted">{{ block.settings.text }}</div>{%- endif -%}
            {%- if product != blank -%}
              <a href="{{ product.url }}" class="link-underline meaning__link">{{ 'products.shop_design' | t }}</a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Design meanings",
  "class": "section-meanings",
  "max_blocks": 30,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "light", "label": "Light" }
      ],
      "default": "white"
    },
    { "type": "text", "id": "eyebrow", "label": "Small label above heading", "default": "Scripture Editorial" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The meaning behind the designs" },
    { "type": "richtext", "id": "text", "label": "Intro" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Top spacing", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Bottom spacing", "default": 96 }
  ],
  "blocks": [
    {
      "type": "design",
      "name": "Design",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Uses the product photo if empty." },
        { "type": "text", "id": "title", "label": "Design name", "default": "The King Returns" },
        { "type": "text", "id": "verse", "label": "Verse reference" },
        { "type": "richtext", "id": "text", "label": "Reflection" }
      ]
    }
  ],
  "presets": [{ "name": "Design meanings", "blocks": [{ "type": "design" }, { "type": "design" }] }]
}
{% endschema %}
