<div class="page-width account-auth">
  <div class="account-auth__box">
    <h1 class="h1">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', novalidate: 'novalidate' -%}
      {%- if form.errors -%}<p class="form-message" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="account-auth__fields form-grid">
        <div>
          <label class="form-label" for="RegFirst">{{ 'customer.first_name' | t }}</label>
          <input class="field__input" id="RegFirst" type="text" name="customer[first_name]" autocomplete="given-name" value="{{ form.first_name }}">
        </div>
        <div>
          <label class="form-label" for="RegLast">{{ 'customer.last_name' | t }}</label>
          <input class="field__input" id="RegLast" type="text" name="customer[last_name]" autocomplete="family-name" value="{{ form.last_name }}">
        </div>
        <div class="form-grid__full">
          <label class="form-label" for="RegEmail">{{ 'customer.email' | t }}</label>
          <input class="field__input" id="RegEmail" type="email" name="customer[email]" autocomplete="email" autocapitalize="off" required value="{{ form.email }}">
        </div>
        <div class="form-grid__full">
          <label class="form-label" for="RegPassword">{{ 'customer.password' | t }}</label>
          <input class="field__input" id="RegPassword" type="password" name="customer[password]" autocomplete="new-password" required>
        </div>
        <label class="checkbox-line form-grid__full">
          <input type="checkbox" name="customer[accepts_marketing]" value="true">
          <span>{{ 'customer.register.marketing' | t }}</span>
        </label>
      </div>
      <button type="submit" class="button button--full">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}
    <p class="account-auth__alt">{{ 'customer.register.have_account' | t }} <a href="{{ routes.account_login_url }}" class="link-underline">{{ 'customer.login.title' | t }}</a></p>
  </div>
</div>

{% schema %}
{ "name": "Create account", "class": "section-main-register", "settings": [] }
{% endschema %}
