<div class="page-width account-auth">
  <div class="account-auth__box">
    <h1 class="h1">{{ 'customer.reset.title' | t }}</h1>
    <p class="text-muted">{{ 'customer.reset.text' | t }}</p>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<p class="form-message" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="account-auth__fields">
        <div>
          <label class="form-label" for="ResetPassword">{{ 'customer.password' | t }}</label>
          <input class="field__input" id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
        </div>
        <div>
          <label class="form-label" for="ResetConfirm">{{ 'customer.confirm_password' | t }}</label>
          <input class="field__input" id="ResetConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
        </div>
      </div>
      <button type="submit" class="button button--full">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{ "name": "Reset password", "class": "section-main-reset", "settings": [] }
{% endschema %}
