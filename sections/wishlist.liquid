{%- assign s = section.settings -%}
<section class="wishlist section-spacing" style="--pad-top: {{ s.padding_top }}px; --pad-bottom: {{ s.padding_bottom }}px;" data-wishlist-page>
  <div class="page-width">
    <div class="collection-banner__content" style="padding-top: 0;">
      <h1 class="h1">{{ s.heading }}</h1>
      <p class="text-muted">{{ s.text }}</p>
    </div>
    <ul class="product-grid product-grid--4" role="list" data-wishlist-grid></ul>
    <div class="collection__empty" data-wishlist-empty hidden>
      <p class="h3">{{ 'wishlist.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'sections.cart.continue' | t }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wishlist",
  "class": "section-wishlist",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your wishlist" },
    { "type": "text", "id": "text", "label": "Text", "default": "Saved on this device." },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Top spacing", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Bottom spacing", "default": 96 }
  ]
}
{% endschema %}
