{%- assign s = section.settings -%}
<div class="password scheme-navy">
  {%- if s.image != blank -%}
    <div class="password__media media">
      {{ s.image | image_url: width: 2000 | image_tag: loading: 'eager', sizes: '100vw', widths: '750, 1100, 1500, 2000', alt: '' }}
    </div>
  {%- endif -%}

  <div class="password__inner">
    <div class="password__logo">{% render 'logo', inverse: true %}</div>

    <div class="password__content">
      {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h1 class="h0 password__heading">{{ s.heading }}</h1>{%- endif -%}
      {%- if s.text != blank -%}<div class="rte password__text">{{ s.text }}</div>{%- endif -%}

      {%- form 'customer', id: 'WaitlistForm', class: 'newsletter-form newsletter-form--center' -%}
        <input type="hidden" name="contact[tags]" value="waitlist,newsletter,weekly-verse">
        {%- if form.posted_successfully? -%}
          <p class="password__success" role="status">{{ s.success_message }}</p>
        {%- else -%}
          <div class="field">
            <label class="visually-hidden" for="WaitlistEmail">{{ 'sections.footer.email' | t }}</label>
            <input id="WaitlistEmail" class="field__input" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'sections.footer.email' | t }}" required>
            <button type="submit" class="button">{{ s.button_label }}</button>
          </div>
          {%- if form.errors -%}
            <p class="form-message" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
          <p class="footer__privacy">{{ s.privacy_text }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>

    <div class="password__footer">
      {% render 'social-links' %}
      <details class="password__admin">
        <summary>{{ 'password.enter' | t }}</summary>
        {%- form 'storefront_password', class: 'password__admin-form' -%}
          {%- if form.errors -%}
            <p class="form-message" role="alert">{{ form.errors | default_errors }}</p>
            <script>document.addEventListener('DOMContentLoaded', () => { document.querySelector('.password__admin').open = true; });</script>
          {%- endif -%}
          <label class="visually-hidden" for="StorePassword">{{ 'password.label' | t }}</label>
          <div class="field">
            <input class="field__input" id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}">
            <button type="submit" class="button">{{ 'password.submit' | t }}</button>
          </div>
        {%- endform -%}
      </details>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Coming soon",
  "class": "section-password",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Small label above heading", "default": "Launching November 9" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not for us. For His glory." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Premium Christian apparel, made for you. Join the list for first access on launch day and the Weekly Verse.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join the list" },
    { "type": "text", "id": "privacy_text", "label": "Small print", "default": "A scripture every week, plus early access to new drops and occasional offers. Unsubscribe anytime." },
    { "type": "text", "id": "success_message", "label": "Thank-you message", "default": "You're on the list. See you on launch day." }
  ]
}
{% endschema %}
