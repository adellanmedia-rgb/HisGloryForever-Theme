{%- assign s = section.settings -%}
<div class="password scheme-navy{% if s.show_winter %} password--winter{% endif %}{% if s.show_paper %} password--paper{% endif %}">
  {%- if s.show_winter -%}
    <div class="winter__sceneWrap" aria-hidden="true">{% render 'winter-scene' %}</div>
    <div class="winter__star" aria-hidden="true">
      <span class="winter__glow"></span>
      <svg viewBox="-50 -50 100 100" focusable="false"><path d="M0,-46 C3,-12 12,-3 46,0 C12,3 3,12 0,46 C-3,12 -12,3 -46,0 C-12,-3 -3,-12 0,-46Z" fill="#D8BE86"/><path d="M0,-20 C1.5,-5 5,-1.5 20,0 C5,1.5 1.5,5 0,20 C-1.5,5 -5,1.5 -20,0 C-5,-1.5 -1.5,-5 0,-20Z" fill="#F6E9C8" transform="rotate(45)" opacity=".55"/></svg>
    </div>
    <canvas class="winter__snow" aria-hidden="true"></canvas>
  {%- endif -%}
  {%- if s.show_paper -%}
    <div class="hgf-paper" aria-hidden="true" style="background-image: url('{{ 'hgf-cardstock.jpg' | asset_url }}');"></div>
  {%- endif -%}
  {%- if s.image != blank -%}
    <div class="password__media media">
      {{ s.image | image_url: width: 2000 | image_tag: loading: 'eager', sizes: '100vw', widths: '750, 1100, 1500, 2000', alt: '' }}
    </div>
  {%- endif -%}

  <div class="password__inner">
    <div class="password__logo">{% render 'logo', inverse: true %}</div>

    <div class="password__content">
      {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h1 class="h0 password__heading">{{ s.heading }}</h1>{%- endif -%}
      {%- if s.text != blank -%}<div class="rte password__text">{{ s.text }}</div>{%- endif -%}

      {%- if s.show_countdown and s.launch_date != blank -%}
        <div class="countdown" data-countdown="{{ s.launch_date | escape }}" role="timer" aria-label="{{ s.countdown_label | escape }}" hidden>
          {%- if s.countdown_label != blank -%}<span class="countdown__label">{{ s.countdown_label }}</span>{%- endif -%}
          <div class="countdown__units">
            <div class="countdown__unit"><span class="countdown__num" data-unit="days">00</span><span class="countdown__name">{{ 'password.countdown.days' | t }}</span></div>
            <div class="countdown__unit"><span class="countdown__num" data-unit="hours">00</span><span class="countdown__name">{{ 'password.countdown.hours' | t }}</span></div>
            <div class="countdown__unit"><span class="countdown__num" data-unit="minutes">00</span><span class="countdown__name">{{ 'password.countdown.minutes' | t }}</span></div>
            <div class="countdown__unit"><span class="countdown__num" data-unit="seconds">00</span><span class="countdown__name">{{ 'password.countdown.seconds' | t }}</span></div>
          </div>
        </div>
      {%- endif -%}

      {%- assign app_blocks = section.blocks | where: 'type', '@app' -%}
      {%- if app_blocks.size > 0 -%}
        {%- if s.form_lead != blank -%}<p class="password__lead">{{ s.form_lead }}</p>{%- endif -%}
        <div class="password__app-form">
          {%- for block in app_blocks -%}{% render block %}{%- endfor -%}
        </div>
        {%- if s.form_note != blank -%}<p class="password__note">{{ s.form_note }}</p>{%- endif -%}
        <script>
          (function () {
            var css = '[class*=formSubmitButton],[class*=formSubmitButton] *{text-transform:uppercase!important;letter-spacing:.14em!important;font-size:13px!important;font-weight:500!important}[class*=checkboxField] [class*=textBody]{font-size:12.5px!important;line-height:1.5!important;color:rgba(255,255,255,.72)!important}';
            var tries = 0;
            (function style() {
              var host = document.querySelector('.password__app-form shopify-forms-embed');
              var root = host && host.shadowRoot;
              if (root && !root.querySelector('style[data-hgf]')) {
                var el = document.createElement('style');
                el.setAttribute('data-hgf', '');
                el.textContent = css;
                root.appendChild(el);
              }
              if ((!root || !root.querySelector('[class*=formSubmitButton]')) && tries++ < 40) setTimeout(style, 250);
            })();
          })();
        </script>
      {%- elsif s.brevo_form != blank -%}
        <div class="brevo-embed">{{ s.brevo_form }}</div>
      {%- else -%}
      {%- form 'customer', id: 'WaitlistForm', class: 'newsletter-form newsletter-form--center' -%}
        <input type="hidden" name="contact[tags]" value="waitlist,newsletter,weekly-verse">
        {%- if form.posted_successfully? -%}
          <p class="password__success" role="status">{{ s.success_message }}</p>
        {%- else -%}
          <div class="field">
            <label class="visually-hidden" for="WaitlistEmail">{{ 'sections.footer.email' | t }}</label>
            <input id="WaitlistEmail" class="field__input" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'sections.footer.email' | t }}" required>
            <button type="submit" class="button">{{ s.button_label }}</button>
          </div>
          {%- if form.errors -%}
            <p class="form-message" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
          <p class="footer__privacy">{{ s.privacy_text }}</p>
        {%- endif -%}
      {%- endform -%}
      {%- endif -%}
    </div>

    {%- if s.show_glimpse -%}
      {%- liquid
        assign glimpse_ar = 1.7778
        if s.glimpse_image != blank
          assign glimpse_ar = s.glimpse_image.aspect_ratio
        endif
        assign glimpse_ar_mobile = 0.75
        if s.glimpse_image_mobile != blank
          assign glimpse_ar_mobile = s.glimpse_image_mobile.aspect_ratio
        elsif s.glimpse_image != blank
          assign glimpse_ar_mobile = glimpse_ar
        endif
      -%}
      <figure class="password__glimpse" style="--glimpse-ar: {{ glimpse_ar }}; --glimpse-ar-mobile: {{ glimpse_ar_mobile }};">
        <div class="media password__glimpse-media">
          {%- if s.glimpse_image != blank -%}
            <picture>
              {%- if s.glimpse_image_mobile != blank -%}
                <source
                  media="(max-width: 749px)"
                  srcset="{{ s.glimpse_image_mobile | image_url: width: 600 }} 600w, {{ s.glimpse_image_mobile | image_url: width: 900 }} 900w, {{ s.glimpse_image_mobile | image_url: width: 1200 }} 1200w, {{ s.glimpse_image_mobile | image_url: width: 1600 }} 1600w"
                  sizes="100vw"
                >
              {%- endif -%}
              {{ s.glimpse_image | image_url: width: 2000 | image_tag: loading: 'eager', sizes: '(min-width: 990px) 900px, 100vw', widths: '600, 900, 1200, 1600, 2000', alt: s.glimpse_caption }}
            </picture>
          {%- else -%}
            {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- if s.verse_text != blank -%}
          <blockquote class="password__verse">
            <p>{{ s.verse_text }}</p>
            {%- if s.verse_reference != blank -%}<cite>{{ s.verse_reference }}</cite>{%- endif -%}
          </blockquote>
        {%- endif -%}
        {%- if s.glimpse_caption != blank -%}<figcaption class="password__glimpse-caption">{{ s.glimpse_caption }}</figcaption>{%- endif -%}
      </figure>
    {%- endif -%}

    {%- if s.show_footer -%}
    <div class="password__footer">
      {% render 'social-links' %}
      <details class="password__admin">
        <summary>{{ 'password.enter' | t }}</summary>
        {%- form 'storefront_password', class: 'password__admin-form' -%}
          {%- if form.errors -%}
            <p class="form-message" role="alert">{{ form.errors | default_errors }}</p>
            <script>document.addEventListener('DOMContentLoaded', () => { document.querySelector('.password__admin').open = true; });</script>
          {%- endif -%}
          <label class="visually-hidden" for="StorePassword">{{ 'password.label' | t }}</label>
          <div class="field">
            <input class="field__input" id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}">
            <button type="submit" class="button">{{ 'password.submit' | t }}</button>
          </div>
        {%- endform -%}
      </details>
    </div>
    {%- endif -%}
  </div>
</div>

{%- if s.show_winter -%}
<script>
  (function () {
    var hero = document.querySelector('.password--winter');
    if (!hero) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var c = hero.querySelector('.winter__snow');
    var x = c.getContext('2d');
    var dpr = Math.min(window.devicePixelRatio || 1, 2), w, h, flakes = [], raf;
    function mk(any) { var r = Math.random(); return { x: Math.random() * w, y: any ? Math.random() * h : -6, r: 0.6 + r * r * 1.8, v: 0.18 + r * 0.42, a: 0.25 + Math.random() * 0.5, p: Math.random() * 6.28, s: 0.004 + Math.random() * 0.008 }; }
    function size() { w = hero.clientWidth; h = hero.clientHeight; c.width = w * dpr; c.height = h * dpr; x.setTransform(dpr, 0, 0, dpr, 0, 0); var n = Math.round(Math.min(90, w / 20)); flakes = []; for (var i = 0; i < n; i++) flakes.push(mk(true)); }
    function draw() { x.clearRect(0, 0, w, h); for (var i = 0; i < flakes.length; i++) { var f = flakes[i]; f.y += f.v; f.p += f.s; f.x += Math.sin(f.p) * 0.25; if (f.y > h + 6) flakes[i] = mk(false); x.globalAlpha = f.a; x.beginPath(); x.arc(f.x, f.y, f.r, 0, 6.283); x.fillStyle = '#F4EEE2'; x.fill(); } x.globalAlpha = 1; }
    function loop() { draw(); raf = requestAnimationFrame(loop); }
    size();
    var rt; window.addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(size, 150); });
    if (reduce) { draw(); return; }
    loop();
    document.addEventListener('visibilitychange', function () { if (document.hidden) cancelAnimationFrame(raf); else loop(); });
    var layers = [].slice.call(hero.querySelectorAll('.winter__layer'));
    var wrap = hero.querySelector('.winter__sceneWrap');
    window.addEventListener('scroll', function () {
      var rect = wrap.getBoundingClientRect();
      var off = Math.max(-200, Math.min(200, rect.top - window.innerHeight));
      layers.forEach(function (l) { var d = parseFloat(l.getAttribute('data-depth')) || 0; l.style.transform = 'translateY(' + (off * d) + 'px)'; });
    }, { passive: true });
  })();
</script>
{%- endif -%}

{%- if s.show_countdown and s.launch_date != blank -%}
<script>
  (function () {
    var el = document.querySelector('[data-countdown]');
    if (!el) return;
    var target = Date.parse(el.getAttribute('data-countdown'));
    if (isNaN(target)) return;
    var nums = {};
    el.querySelectorAll('[data-unit]').forEach(function (n) { nums[n.getAttribute('data-unit')] = n; });
    function pad(n) { return n < 10 ? '0' + n : String(n); }
    function tick() {
      var diff = target - Date.now();
      if (diff <= 0) { el.hidden = true; clearInterval(timer); return; }
      var t = Math.floor(diff / 1000);
      nums.days.textContent = pad(Math.floor(t / 86400));
      nums.hours.textContent = pad(Math.floor(t % 86400 / 3600));
      nums.minutes.textContent = pad(Math.floor(t % 3600 / 60));
      nums.seconds.textContent = pad(t % 60);
      el.hidden = false;
    }
    var timer = setInterval(tick, 1000);
    tick();
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Coming soon",
  "class": "section-password",
  "blocks": [{ "type": "@app" }],
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Small label above heading", "default": "Coming November 9" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not for us. For His glory." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Premium Christian apparel, made for you. Join the list for first access on launch day and the Weekly Verse.</p>" },
    {
      "type": "html",
      "id": "brevo_form",
      "label": "Brevo form embed code",
      "info": "Optional. Paste the embed code of a Brevo form (email, phone and SMS consent). When filled, it replaces the built-in signup form."
    },
    { "type": "text", "id": "form_lead", "label": "Offer line above the signup form", "default": "List members shop 24 hours early · Sunday, November 8" },
    { "type": "text", "id": "form_note", "label": "Line under the signup form", "default": "Gifts that carry His Word · Free shipping on US orders over $100" },
    { "type": "header", "content": "Countdown" },
    { "type": "checkbox", "id": "show_countdown", "label": "Show countdown to launch", "default": true },
    { "type": "text", "id": "launch_date", "label": "Launch date and time", "default": "2026-11-09T00:00:00-05:00", "info": "Format: 2026-11-09T00:00:00-05:00 (midnight Eastern). The countdown hides itself once this time passes." },
    { "type": "text", "id": "countdown_label", "label": "Countdown label", "default": "The collection arrives in" },
    { "type": "header", "content": "Signup form" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join the list" },
    { "type": "text", "id": "privacy_text", "label": "Small print", "default": "A scripture every week, plus early access to new collections and occasional offers. Unsubscribe anytime." },
    { "type": "text", "id": "success_message", "label": "Thank-you message", "default": "You're on the list. See you on launch day." },
    { "type": "header", "content": "First glimpse" },
    { "type": "checkbox", "id": "show_glimpse", "label": "Show a detail close-up", "default": true },
    { "type": "image_picker", "id": "glimpse_image", "label": "Detail photo", "info": "A tight close-up of one detail: part of a print, the sleeve embroidery, the fabric. Not the whole garment. Shown uncropped at its own shape." },
    { "type": "image_picker", "id": "glimpse_image_mobile", "label": "Detail photo on phones", "info": "Optional. A tall (4:5) version for phones. Leave empty to use the photo above." },
    { "type": "text", "id": "verse_text", "label": "Verse under the photo", "default": "\u201cBehold, I am coming soon.\u201d" },
    { "type": "text", "id": "verse_reference", "label": "Verse reference", "default": "Revelation 22:12" },
    { "type": "text", "id": "glimpse_caption", "label": "Caption", "default": "A first glimpse. The full collection arrives November 9." },
    { "type": "header", "content": "Holiday season" },
    { "type": "checkbox", "id": "show_winter", "label": "Show winter scene", "default": false, "info": "Snowy landscape, guiding star and gentle snowfall. Turn off after the holidays (early January)." },
    { "type": "checkbox", "id": "show_paper", "label": "Cardstock paper texture", "default": true, "info": "A printed-card texture over the navy. Works year-round." },
    { "type": "header", "content": "Footer" },
    { "type": "checkbox", "id": "show_footer", "label": "Show social links and store-owner login here", "default": true, "info": "Turn off when the separate Coming soon footer section is added below." }
  ]
}
{% endschema %}
